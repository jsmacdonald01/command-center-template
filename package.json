{
  "name": "my-command-center",
  "version": "1.0.0",
  "description": "Command Center — a personal dashboard for your lists, money, documents, notes and calendar, with Claude built in",
  "main": "electron/main.js",
  "private": true,
  "author": "",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "node scripts/fetch-sqlite-binary.js && node scripts/brand-electron.js && vite build && electron-builder --win --x64 --publish never",
    "release": "node scripts/release.js",
    "setup": "node scripts/fetch-sqlite-binary.js && node scripts/brand-electron.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.8.9",
    "googleapis": "^173.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "app.mycommandcenter",
    "productName": "My Command Center",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "dist-renderer/**/*",
      "config/**/*",
      "notebook-starter/**/*",
      "mcp/**/*",
      "build/icon.ico"
    ],
    "afterPack": "scripts/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "jsmacdonald01",
      "repo": "command-center-template"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "My-Command-Center-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "electron/vendor/pdfjs/**",
      "electron/vendor/ocr/**"
    ]
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.25.12": true
  }
}
